# ==========================================
# WindScope UK — Environment Variables
# ==========================================

# --- Backend (FastAPI / Render.com) ---
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
HOST=0.0.0.0
PORT=8000
CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=20
CORS_ORIGINS=*

# --- Frontend (Vite / Vercel) ---
# Set this to your Render backend public URL after deployment
# Example: https://windscope-backend.onrender.com
VITE_API_BASE_URL=https://YOUR-RENDER-BACKEND.onrender.com
